# ================================================
# LOCAL DEVELOPMENT — Docker MySQL (xem docker-compose.yml)
# Port 3307 de tranh xung dot voi MySQL80 he thong (3306).
# ================================================
DATABASE_URL="mysql://pinterest:pinterest_capstone_pwd@localhost:3307/pinterest_orm"

# PORT chi dung LOCAL (server.js). Vercel quan li port tu chinh no.
PORT=8000

# ============ PRODUCTION (Vercel) ============
# Khi deploy len Vercel, dat cac bien duoi truc tiep vao
# Project Settings -> Environment Variables. KHONG xac nhan len .env.
#   DATABASE_URL      : mysql://USER:PASSWORD@HOST:PORT/DATABASE  (MySQL cloud)
#   JWT_SECRET        : gia tri ngau nhien du manh, khong ai duoc doan duoc
#   JWT_EXPIRES_IN    : vi du 7d
#   CYBERSOFT_TOKEN   : token Cybersoft cua ban
# khong can (Vercel se set):
#   PORT
# ================================================
JWT_SECRET=your_jwt_secret_change_me
JWT_EXPIRES_IN=7d
CYBERSOFT_TOKEN=your_cybersoft_token_here
